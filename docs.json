{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Keystone Commerce API Docs",
  "colors": {
    "primary": "#FF6608",
    "light": "#FF6608",
    "dark": "#FF6608"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "API Docs",
        "pages": [
          "index",
          "getting-started",
          "authentication",
          "catalog",
          "customers",
          "orders-payments",
          "wallet",
          "returns-support",
          "errors"
        ]
      },
      {
        "tab": "Orbis Nova",
        "hidden": true,
        "pages": [
          "orbis-nova",
          "orbis-nova/products",
          "orbis-nova/orders",
          "orbis-nova/order-status",
          "orbis-nova/order-updates",
          "orbis-nova/errors"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/api-docs-light.svg",
    "dark": "/logo/api-docs-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:tech@keystonecommerce.in"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
